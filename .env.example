# ===========================================================================
# CloudVault AI — environment variables
# Copy to `.env` for local development. Never commit `.env`.
# ===========================================================================

# --- Core -------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cloudvault?schema=public"
AUTH_SECRET="generate-a-unique-secret-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
APP_VERSION="0.1.0"

# Optional Google sign-in. Both values are required to enable the provider.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Signs password-protected share-link cookies. Falls back to AUTH_SECRET.
SHARE_SECRET="generate-a-unique-secret-with-openssl-rand-base64-32"

# --- Supabase Storage -------------------------------------------------------
# Optional. When the URL and a service key are set, uploads use a private
# Supabase bucket with short-lived signed URLs instead of local disk.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-publishable-anon-key"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="cloudvault"

# Local storage root (used when Supabase Storage is not configured). Relative
# paths resolve from the project directory. Mount a durable volume in Docker.
CLOUDVAULT_STORAGE_DIR=""

# --- Rate limiting ----------------------------------------------------------
# Optional Redis REST store shared across instances (Upstash / Vercel KV).
# Set both the URL and token for one pair. Without it, an in-process fixed-
# window limiter is used, which only protects a single server instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Vercel KV aliases (also supported):
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# --- Observability ----------------------------------------------------------
# debug | info | warn | error. Defaults to debug in development, info in prod.
LOG_LEVEL=""
# json | pretty. Defaults to pretty in development, json in production.
LOG_FORMAT=""
# Optional bearer token. When set, /api/health requires
# `Authorization: Bearer <token>`. Leave empty for a public liveness probe.
HEALTH_CHECK_TOKEN=""

# --- Optional malware scanner ----------------------------------------------
# The endpoint must accept multipart/form-data with a `file` field and return
# { "clean": true | false, "reason"?: string }.
MALWARE_SCAN_URL=""
MALWARE_SCAN_TOKEN=""

# ---------------------------------------------------------------------------
# AI providers (optional). With no keys, CloudVault AI uses built-in local
# embeddings and an extractive fallback so every AI feature keeps working.
# ---------------------------------------------------------------------------
# auto = OpenAI, then Gemini, then local. Or force: openai | gemini | local.
AI_PROVIDER="auto"

OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
# Optional OpenAI-compatible gateway (must expose /chat/completions and /embeddings).
OPENAI_BASE_URL="https://api.openai.com/v1"

# GEMINI_API_KEY (or GOOGLE_GENERATIVE_AI_API_KEY / GOOGLE_API_KEY) enables Gemini.
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-2.0-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# auto follows AI_PROVIDER. Or force: openai | gemini | local.
AI_EMBEDDING_PROVIDER="auto"
# Optional embedding size override. Provider defaults are 1536 (OpenAI small),
# 3072 (OpenAI large / Gemini gemini-embedding-001), or 768 (Gemini 004).
AI_EMBEDDING_DIMENSIONS=""

# Per-user requests per UTC day across chat, summaries, keywords, and tags.
AI_DAILY_REQUEST_LIMIT="120"
# Context and response budgeting for chat.
AI_MAX_CONTEXT_CHARS="14000"
AI_MAX_OUTPUT_TOKENS="900"
AI_TEMPERATURE="0.2"
